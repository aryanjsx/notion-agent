# ==============================================================================
# Notion AI Agent - Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and supply your credentials.
# In local development, leaving GCP variables as defaults triggers automatic
# in-memory / local filesystem mock fallbacks.
# ==============================================================================

# --- Google Cloud Platform Settings ---
GCP_PROJECT_ID=local-dev-project
GCP_REGION=us-central1
ENVIRONMENT=development

# --- Notion Integration Settings ---
# Create an integration at https://www.notion.so/my-integrations
# Ensure you invite the integration to any Notion page/database you want it to access.
NOTION_TOKEN=secret_your_notion_internal_integration_token_here
NOTION_API_VERSION=2022-06-28

# --- LLM & Reasoning Settings (Gemini on GCP Vertex AI) ---
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=gemini-1.5-pro-002

# --- Storage & Cloud Tasks ---
GCS_BUCKET_NAME=my-notion-agent-attachments
CLOUD_TASKS_QUEUE=notion-agent-tasks
CLOUD_TASKS_LOCATION=us-central1
WORKER_SERVICE_URL=http://localhost:8080/tasks/worker/execute

# --- Notification Channels ---
# 1. Slack (Optional: for Slack notifications)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# 2. Email / SendGrid (Optional: for Email notifications)
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=notion-agent@yourdomain.com

# --- Security & Webhooks ---
# Shared secret for verifying incoming Notion webhooks (optional)
NOTION_WEBHOOK_SECRET=your_notion_webhook_signing_secret
